@inherits BaseView;

@if (IsLoading())
{
    <div class="loader"></div>
}
else
{
    <div class="modal fade" id="AddGradeToStudentReturingModal" tabindex="-1"
         aria-labelledby="AddGradeToStudentReturingModal" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header py-3">
                    <h5 class="modal-title text-gray-800 font-weight-bold">
                        <i class="fas fa-graduation-cap mr-2"></i>Añade o actualiza calificaciones por parcial.
                    </h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>

                <div class="modal-body">

                    <div class="card shadow-sm mb-4 border-left-primary">
                        <div class="card-body py-3 px-4">
                            <div class="row align-items-center">
                                <!-- 1. Información del Estudiante -->
                                <div class="col-lg-5 mb-3 mb-lg-0">
                                    <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                        Estudiante
                                    </div>
                                    <div
                                        class="h6 mb-0 font-weight-bold text-gray-800 d-flex align-items-center flex-wrap">
                                        <span class="mr-2">
                                            <i class="fas fa-user-graduate text-gray-400 mr-1"></i>@FullStudent.FullName()
                                        </span>
                                        <span
                                            class="badge badge-light text-primary border border-primary-subtle px-2 py-1">
                                            <i class="fas fa-id-card mr-1"></i>@StudentId </span>
                                    </div>
                                </div>

                                <!-- Separador Vertical (Solo en pantallas grandes) -->
                                <div class="col-auto d-none d-lg-block border-right py-3"></div>

                                <!-- 2. Selector de Parciales en formato Chips / Pills -->
                                <div class="col-lg mb-3 mb-lg-0 pl-lg-4">
                                    <div class="text-xs font-weight-bold text-gray-600 text-uppercase mb-2">
                                        <i class="fas fa-filter mr-1"></i>Parcial
                                    </div>
                                    <div class="d-flex flex-wrap gap-2">
                                        @foreach (var item in PartialList)
                                        {
                                            bool isChecked = PartialId == item.partialId;

                                            <div class="custom-control custom-checkbox p-0 mr-2 mb-1">
                                                <!-- Input Checkbox Oculto para preservar la binding nativa -->
                                                <input type="checkbox"
                                                       id="chk-@item.partialId"
                                                       class="d-none"
                                                       checked="@isChecked"
                                                       @onchange="(e) => OnCheckboxChange(e, item.partialId)"/>

                                                <!-- Label estilizado como Chip interactivo -->
                                                <label for="chk-@item.partialId"
                                                       class="btn btn-sm mb-0 rounded-pill px-3 shadow-none transition-all @(isChecked ? "btn-primary font-weight-bold" : "btn-outline-secondary")"
                                                       style="cursor: pointer;">
                                                    @if (isChecked)
                                                    {
                                                        <i class="fas fa-check-circle mr-1"></i>
                                                    }
                                                    @item.label
                                                </label>
                                            </div>
                                        }
                                    </div>
                                </div>

                                <!-- 3. Botón Buscar -->
                                <div class="col-lg-auto text-lg-right">
                                    <button type="button"
                                            class="btn btn-primary btn-sm px-3 shadow-sm rounded-pill"
                                            disabled="@(PartialId == null)"
                                            @onclick="GetGradeInfo">
                                        <i class="fas fa-search mr-1"></i> Buscar
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (DetailSubject.Any())
                    {
                        <!-- Card Estándar SB-Admin 2 -->
                        <div class="card shadow mb-4">
                            <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                                <h6 class="m-0 font-weight-bold text-primary">Calificaciones por Asignatura</h6>
                                <span class="text-xs font-weight-bold text-secondary">Total: @DetailSubject.Count</span>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-bordered mb-0" width="100%" cellspacing="0">
                                        <thead class="bg-light">
                                        <tr>
                                            <th>Asignatura</th>
                                            <th>Profesor</th>
                                            <th class="text-center" style="width: 120px;">Calificación</th>
                                            <th class="text-center" style="width: 120px;">Conducta</th>
                                        </tr>
                                        </thead>
                                        <tbody>
                                        @for (int i = 0; i < DetailSubject.Count; i++)
                                        {
                                            var index = i;
                                            var item = DetailSubject[index];
                                            var subjectName = SubjectCatalog.FirstOrDefault(s => s.subjectId == item.subjectId)?.name ?? "Sin nombre";
                                            var teacherName = TeachersCatalog.FirstOrDefault(t => t.teacherId == item.teacherId)?.fullName ?? "Sin docente asignado";

                                            <tr @key="item.subjectId">
                                                <td class="align-middle">@subjectName</td>
                                                <td class="align-middle">@teacherName</td>
                                                <td class="align-middle text-center">
                                                    <input type="number" min="0" max="100"
                                                           class="form-control form-control-sm text-center no-spinner @(Grade.grades[index].grade < 60 ? "is-invalid" : "")"
                                                           @bind="Grade.grades[index].grade"
                                                           @bind:event="oninput"
                                                           @bind:after="() => SanitizeIndex(index, isConduct: false)"
                                                           @onwheel:preventDefault/>
                                                </td>
                                                <td class="align-middle text-center">
                                                    <input type="number" min="0" max="100"
                                                           class="form-control form-control-sm text-center no-spinner @(Grade.grades[index].conductgrade < 60 ? "is-invalid" : "")"
                                                           @bind="Grade.grades[index].conductgrade"
                                                           @bind:event="oninput"
                                                           @bind:after="() => SanitizeIndex(index, isConduct: true)"
                                                           @onwheel:preventDefault/>
                                                </td>
                                            </tr>
                                        }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- Estado Vacío Simple SB-Admin 2 -->
                        <div class="card shadow mb-4">
                            <div class="card-body text-center text-muted py-4">
                                No hay asignaturas disponibles.
                            </div>
                        </div>
                    }


                </div>

                <div class="modal-footer bg-gray-100">
                    <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">
                        <i class="fas fa-times mr-1"></i> Cancelar
                    </button>
                    <button type="button" class="btn btn-primary btn-sm" @onclick="Save">
                        <i class="fas fa-save mr-1"></i> Actualizar
                    </button>
                </div>
            </div>
        </div>
    </div>
}